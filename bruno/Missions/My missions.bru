meta {
  name: My missions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/missions?participating=true
  body: none
  auth: inherit
}

params:query {
  participating: true
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.length: eq 3
  res.body.data[0].name: eq Juno
}

docs {
  The content is filtered with the user id found in the token (`sub` claim), never with a parameter sent by the client.
}
