meta {
  name: Sort by launch date
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/missions?sort=launchDate
  body: none
  auth: inherit
}

params:query {
  sort: launchDate
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.length: eq 18
  res.body.data[0].id: eq pioneer-11
  res.body.data[0].launchDate: eq 1973-04-06
}

docs {
  Oldest mission first; `sort=-launchDate` puts the most recent one first.
}
