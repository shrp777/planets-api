meta {
  name: Filter and sort missions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/missions?planet=mars&status=active&sort=-launchDate
  body: none
  auth: inherit
}

params:query {
  planet: mars
  status: active
  sort: -launchDate
  ~agency: NASA
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data[0].name: eq Perseverance
}
