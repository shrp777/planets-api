meta {
  name: Filter and sort planets
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/planets?hasRings=true&sort=-diameterKm
  body: none
  auth: none
}

params:query {
  hasRings: true
  sort: -diameterKm
  ~type: gas giant
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data[0].id: eq jupiter
}

docs {
  Enable or disable the query parameters to combine the filters.
  Prefix the sort field with `-` for descending order.
}
