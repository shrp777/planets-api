meta {
  name: Current user with cookie
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.data.email: eq john@doe.com
  res.body.data.id: eq 5f0f4aca-7368-4b38-b2fe-a2ed7925441b
  res.body.data.role: eq astronaut
}

docs {
  No `Authorization` header: the cookie set by `Login with cookie` is sent back by the cookie jar.
}
