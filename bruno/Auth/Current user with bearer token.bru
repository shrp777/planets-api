meta {
  name: Current user with bearer token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.email: eq john@doe.com
  res.body.data.id: eq 5f0f4aca-7368-4b38-b2fe-a2ed7925441b
  res.body.data.role: eq astronaut
}

docs {
  Uses the token stored by the `Get token` request.
}
