meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "john@doe.com",
    "password": "azerty"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.tokenType: eq Bearer
  res.body.data.expiresIn: eq 3600
  res.body.data.accessToken: isString
}

script:post-response {
  bru.setVar("accessToken", res.body.data.accessToken);
}

docs {
  For API clients, with `delivery: token` (the default): the JWT is returned in the body, then sent in the `Authorization: Bearer` header.
}
