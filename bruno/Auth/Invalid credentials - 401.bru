meta {
  name: Invalid credentials - 401
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "john@doe.com",
    "password": "qwerty"
  }
}

assert {
  res.status: eq 401
  res.body.success: eq false
  res.body.error: eq Invalid credentials
}

docs {
  The same message is returned for an unknown email and for a wrong password.
}
